# Pin line endings for the generated editor-types import manifest.
# core.autocrlf=true otherwise perpetually flags this LF file as "modified"
# (it wants a CRLF working copy), so it never leaves the change list.
assets/editor-types/_imports.txt text eol=lf

# Keep this file itself LF so it doesn't hit the same autocrlf churn.
.gitattributes text eol=lf

# patch-package writes patch files LF; pin them so autocrlf doesn't flag them
# as perpetually modified (and so the patches apply byte-exact).
patches/*.patch text eol=lf

# A bundled board's generated lib/ is vendor output copied byte-for-byte out of
# node_modules, and the generator verifies that byte-identity on every run. Letting
# autocrlf rewrite line endings would break that property, make a fresh checkout differ
# from the package it was copied from, and leave all ~186 files perpetually "modified".
# -text disables every text transformation for that tree.
assets/boards/*/lib/** -text
