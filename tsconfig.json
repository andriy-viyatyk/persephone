{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        // TypeScript 6 turned `strict` on by default. The project is not strict: strictNullChecks
        // is enforced per folder by scripts/typecheck-strict.mjs (US-2021).
        "strict": false,
        "noImplicitAny": true,
        "sourceMap": true,
        "outDir": "dist",
        // "bundler", not "node": every entry point is bundled by Vite/rolldown, and node10
        // resolution cannot read a package's `exports` map — which is the only way `ai-vision`
        // and `ai-vision/dom` resolve (US-1389).
        "moduleResolution": "bundler",
        "resolveJsonModule": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "assets",
        "data",
        "out",
        "temp",
        ".vite"
    ]
}
