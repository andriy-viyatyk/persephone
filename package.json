{
  "name": "persephone",
  "productName": "persephone",
  "version": "5.0.21",
  "description": "Persephone",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "node scripts/dev.mjs",
    "build-board-lib": "node scripts/build-board-lib.mjs",
    "build-rest-client-lib": "node scripts/build-rest-client-lib.mjs",
    "build-prod": "node scripts/build-prod.mjs",
    "dist": "node scripts/build-prod.mjs && electron-builder --win",
    "dist:zip": "node scripts/build-prod.mjs && electron-builder --win zip",
    "dist:publish": "node scripts/build-prod.mjs && electron-builder --win --publish always",
    "test:ui": "node integration-test/run.mjs",
    "test:ui:call": "node integration-test/call.mjs",
    "lint": "eslint . && node scripts/describe-tables-check.mjs",
    "describe-tables:check": "node scripts/describe-tables-check.mjs",
    "check:contracts": "node scripts/check-capability-contract.mjs",
    "guides:check": "node scripts/guides-check.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:export": "node scripts/i18n-export.mjs",
    "i18n:check-boards": "node scripts/i18n-check.mjs --boards assets/boards/*",
    "typecheck": "tsc --noEmit && node scripts/typecheck-strict.mjs",
    "mneme:build": "cargo build --release --manifest-path mneme/Cargo.toml",
    "mneme:model": "node scripts/dev-mneme-model.mjs",
    "postinstall": "patch-package"
  },
  "keywords": [],
  "author": {
    "name": "Andriy Viyatyk",
    "email": "viyatyk@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@eslint/js": "^10.0.1",
    "@excalidraw/excalidraw": "^0.18.1",
    "@lezer/highlight": "1.2.5",
    "@types/iconv-lite": "^0.0.1",
    "@types/node": "^24.19.2",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/parser": "^8.72.2",
    "electron": "github:castlabs/electron-releases#v44.9.3+wvcus",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "globals": "^17.14.0",
    "patch-package": "^8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-monaco-editor-esm": "^2.0.3"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ai-vision": "^1.5.0",
    "av-grid": "2.14.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "electron-store": "^12.0.0",
    "hls.js": "^1.7.4",
    "iconv-lite": "^0.7.3",
    "immer": "^11.2.10",
    "jschardet": "^4.1.0",
    "json5": "^2.2.3",
    "jszip": "^3.10.2",
    "libarchive-wasm": "^1.2.0",
    "mermaid": "^12.3.0",
    "monaco-editor": "^0.57.0",
    "picomatch": "^4.0.7",
    "property-information": "^7.2.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "simple-git": "^4.0.2",
    "sucrase": "^3.35.1",
    "turndown": "^7.2.5",
    "unified": "^11.0.0"
  }
}
