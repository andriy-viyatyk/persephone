graph TD
    CTX["ScriptContext"] --> AW["AppWrapper<br/><i>mirrors IApp</i>"]
    CTX --> PW["PageWrapper<br/><i>page identity; editor optional</i>"]

    AW --> |"app.pages"| PCW["PageCollectionWrapper<br/><i>mirrors IPageCollection</i>"]
    AW --> |"app.settings"| SET["settings (direct)"]
    AW --> |"app.fs"| FS["fs (direct)"]
    AW --> |"app.ui"| UI["ui (direct)"]
    AW --> |"app.window"| WIN["window (direct)"]
    AW --> |"app.shell"| SH["shell (direct)"]

    PCW --> |"returns"| PW2["PageWrapper<br/><i>for each open page</i>"]

    PW --> |"page.editor"| EF["current editor's facade<br/><i>TextEditorFacade, GridEditorFacade, …<br/>empty GenericEditorFacade when no editor</i>"]
    PW --> |"page.editorSwitches"| ES["PageEditorSwitchesNode<br/><i>current, options, switchTo</i>"]
    PW --> |"page.panels"| PP["PagePanelsNode"]

    PW --> |"page.grouped"| PW3["PageWrapper<br/><i>auto-created</i>"]

    subgraph RL["Shared releaseList"]
        R1["() => unsubscribe event handler"]
        R2["..."]
    end

    AW -.-> RL

    style CTX fill:#fff3e0
    style AW fill:#e8f5e9
    style PW fill:#e8f5e9
    style PCW fill:#e8f5e9
    style RL fill:#ffebee
