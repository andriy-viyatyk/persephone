classDiagram
    class EditorModel~TState~ {
        <<abstract>>
        +id: string
        +editorId: string
        +state: TOneState~TState~
        +traits: TraitSet
        +contentHost: TextFileModel?
        +filePath / sourceLink / language
        +page: IPageHost?
        +applyRestoreData(data)
        +switchFrom(oldEditor)*
        +restore()*
        +setPage(page)
        +beforeNavigateAway(newEditor)
        +onMainEditorChanged(newMainEditor)
        +survivesNavigation(sourceLink) bool
        +keepAliveOnNavigation() bool
        +getDescriptor(): HostDescriptor
        +dispose()
    }

    class IContentHostTrait {
        <<interface>>
        +extractContentHost(): TextFileModel
    }

    class TextFileModel {
        +pipe: IContentPipe
        +io: TextFileIOModel
        +encryption: TextFileEncryptionModel
    }

