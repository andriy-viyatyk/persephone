graph TB
    PC["PageContent<br/><i>Subscribes to mainEditorId</i>"]

    PC -->|"compareMode"| CMP["CompareEditor"]
    PC -->|"normal"| RE["RenderEditor<br/><i>Single uniform path</i>"]

    RE --> AE["AsyncEditor<br/><i>Lazy-loads module</i>"]
    AE --> EBB["EditorErrorBoundary"]
    EBB --> ED["editor module Editor component<br/><i>e.g. MonacoBody / GridBody / ImageView</i>"]

    ED -->|"text-bearing editors compose"| TC["TextChrome<br/><i>shared toolbar / script-panel / footer</i>"]
    TC --> EB["Editor body<br/><i>MonacoBody / GridBody / MarkdownBody / etc.</i>"]

    ED -->|"non-text editors render directly"| DE["Direct body<br/><i>ImageView / BrowserView / ArchiveView / etc.</i>"]

    style PC fill:#e1f5fe
    style CMP fill:#f3e5f5
    style RE fill:#fff3e0
    style AE fill:#f3e5f5
    style EBB fill:#ffebee
    style ED fill:#e8f5e9
    style TC fill:#c8e6c9
    style EB fill:#e8eaf6
    style DE fill:#e8eaf6
